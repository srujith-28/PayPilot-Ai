# =============================================================================
# PayPilot AI — Environment Configuration Template
# =============================================================================
# IMPORTANT:
# - Copy this file to .env before starting the application: cp .env.example .env
# - Never commit real credentials or private keys to source control.
# - PayPilot AI operates strictly in PayPal Sandbox mode (api-m.sandbox.paypal.com).
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Gemini AI Configuration (Optional, graceful deterministic fallback provided)
# -----------------------------------------------------------------------------
# Obtain your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# Application Hosting URL
# -----------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# PayPal Sandbox Developer Credentials (Required for real Sandbox Order/Invoice API calls)
# -----------------------------------------------------------------------------
# Retrieve from PayPal Developer Portal -> Apps & Credentials (Sandbox Mode):
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Optional PayPal Sandbox Payee Routing
# -----------------------------------------------------------------------------
# If specified, payments will explicitly route to this sandbox merchant account.
# PAYPAL_MERCHANT_ID is prioritized if provided; otherwise PAYPAL_PAYEE_EMAIL is used.
PAYPAL_MERCHANT_ID=""
PAYPAL_PAYEE_EMAIL=""

# -----------------------------------------------------------------------------
# Optional PayPal Sandbox Webhook ID (For incoming webhook verification)
# -----------------------------------------------------------------------------
PAYPAL_WEBHOOK_ID=""
